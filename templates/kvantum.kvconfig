# Generated by build.py from palette.toml; edit templates/kvantum.kvconfig instead.
[%General]
author=ghorshy, based on Graphite by Vince Liuice and KvAdapta by Tsu Jan
comment=Monochrome dark theme matching a Hyprland and Quickshell desktop
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=2
spread_progressbar=true
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=false
splitter_width=1
scroll_width={{ 2 * size.thumb }}
scroll_arrows=false
scroll_min_extent=48
slider_width={{ 2 * size.groove }}
slider_handle_width={{ size.indicator }}
slider_handle_length={{ size.indicator }}
tickless_slider_handle_size={{ size.indicator }}
center_toolbar_handle=true
check_size={{ size.indicator }}
textless_progressbar=false
progressbar_thickness={{ 2 * size.groove }}
menubar_mouse_tracking=true
toolbutton_style=1
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=24
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=true
animate_states=true
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing={{ ui.padding - 2 }}
layout_margin={{ ui.padding }}
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=true
# a 2px gap between a menu and its submenu, so their borders do not merge
submenu_overlap=-2
tooltip_delay=400
tree_branch_line=true
no_window_pattern=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,trojita,dragon,digikam
reduce_window_opacity=0
respect_DE=true
scrollable_menu=false
submenu_delay=150
no_inactiveness=true
reduce_menu_opacity=0
click_behavior=0
contrast=1.00
dialog_button_layout=0
intensity=1.00
saturation=1.00
shadowless_popup=true
drag_from_buttons=false
menu_blur_radius=0
tooltip_blur_radius=0

[GeneralColors]
window.color={{ base }}
base.color={{ view }}
alt.base.color={{ mix(surface, view, opacity.hover / 2) }}
button.color={{ surface }}
light.color={{ overlay }}
mid.light.color={{ mix(surface, overlay, 0.5) }}
dark.color={{ shadow }}
mid.color={{ mix(surface, base, opacity.muted) }}
highlight.color={{ overlay }}
inactive.highlight.color={{ overlay }}
text.color={{ text }}
window.text.color={{ text }}
button.text.color={{ text }}
disabled.text.color={{ textFaint }}
tooltip.text.color={{ text }}
highlight.text.color={{ text }}
inactive.highlight.text.color={{ text }}
link.color={{ link }}
link.visited.color={{ mix(link, text, opacity.muted) }}
progress.indicator.text.color={{ text }}

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
blur_translucent=false
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=true
iconless_menu=false
disabled_icon_opacity=50
lxqtmainmenu_iconsize=16
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_view=true
no_selection_tint=true
transparent_arrow_button=true
middle_click_scroll=false
opaque_colors=false
kinetic_scrolling=false
scroll_jump_workaround=true
centered_forms=false
noninteger_translucency=false
style_vertical_toolbars=false
blur_only_active_window=true

# Compact: with a 10pt font buttons, fields and menu rows are 24px tall
# (14px of text plus a 4px frame and 1px of text margin on each side).
# Frame sizes come from build.py (size.*), which draws the SVG pieces to match.

[PanelButtonCommand]
frame=true
frame.element=button
# keyboard focus is drawn as <element>-focus on the widget's edge
focusFrame=true
frame.top={{ size.frame }}
frame.bottom={{ size.frame }}
frame.left={{ size.frame }}
frame.right={{ size.frame }}
interior=true
interior.element=button
indicator.size=8
text.normal.color={{ text }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
text.disabled.color={{ textFaint }}
text.shadow=0
text.margin.top=1
text.margin.bottom=1
text.margin.left={{ ui.padding }}
text.margin.right={{ ui.padding }}
text.iconspacing={{ ui.padding }}
indicator.element=arrow
frame.expansion=0

[PanelButtonTool]
inherits=PanelButtonCommand
text.bold=false
indicator.element=arrow
indicator.size=0

[ToolbarButton]
frame=true
frame.element=tbutton
interior.element=tbutton
frame.top={{ size.frame }}
frame.bottom={{ size.frame }}
frame.left={{ size.frame }}
frame.right={{ size.frame }}
text.margin.top=0
text.margin.bottom=0
text.margin.left=2
text.margin.right=2
indicator.element=tarrow
text.normal.color={{ text }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
text.bold=false
frame.expansion=0

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color={{ text }}

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color={{ textDim }}
text.focus.color={{ text }}
text.bold=false

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=spin
indicator.size=8
text.normal.color={{ text }}

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin=0
text.normal.color={{ text }}
text.focus.color={{ text }}

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin=0
text.normal.color={{ text }}
text.focus.color={{ text }}

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
interior=false
frame.top={{ size.focus }}
frame.bottom={{ size.focus }}
frame.left={{ size.focus }}
frame.right={{ size.focus }}
frame.patternsize=0

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[ToolbarLineEdit]
frame.element=lineedit
interior.element=lineedit

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=8

[ToolboxTab]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
indicator.size=16
text.margin.left=8
text.margin.right=8
text.normal.color={{ textDim }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
frame.expansion=0
text.bold=false

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
interior=false

[TreeExpander]
inherits=PanelButtonCommand
indicator.size=8
indicator.element=tree

[HeaderSection]
inherits=PanelButtonCommand
interior.element=header
frame.element=header
frame.top=0
frame.bottom=1
frame.left=0
frame.right=0
text.margin.top=0
text.margin.bottom=0
text.normal.color={{ textDim }}
text.focus.color={{ text }}
text.press.color={{ text }}
text.toggle.color={{ text }}
frame.expansion=0

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
interior.element=menubar
frame.element=menubar
frame.left=6
frame.right=6
frame.top=0
frame.bottom=0
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
focusFrame=true
interior.element=slider
frame.top={{ size.groove }}
frame.bottom={{ size.groove }}
frame.left={{ size.groove }}
frame.right={{ size.groove }}

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top={{ size.groove }}
frame.bottom={{ size.groove }}
frame.left={{ size.groove }}
frame.right={{ size.groove }}
text.margin=0
text.bold=false
frame.expansion=0

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top={{ size.groove }}
frame.bottom={{ size.groove }}
frame.left={{ size.groove }}
frame.right={{ size.groove }}

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4
text.normal.inactive.color={{ text }}
text.focus.inactive.color={{ text }}
text.press.inactive.color={{ text }}
text.toggle.inactive.color={{ text }}

[Splitter]
indicator.size=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=true
interior.element=scrollbarslider
frame.top={{ size.thumb }}
frame.bottom={{ size.thumb }}
frame.left={{ size.thumb }}
frame.right={{ size.thumb }}
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

# Popups have no shadow, so their window is exactly what is drawn and Qt
# places menus and submenus where it means to.
[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top={{ size.popup }}
frame.bottom={{ size.popup }}
frame.left={{ size.popup }}
frame.right={{ size.popup }}
text.shadow=false
frame.expansion=0
text.bold=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.margin.left=2
text.margin.right=2
text.bold=false

[MenuBar]
inherits=PanelButtonCommand
frame.element=menubar
interior.element=menubar
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
frame.expansion=0
text.bold=false

[MenuBarItem]
inherits=PanelButtonCommand
interior=true
interior.element=menubaritem
frame.element=menubaritem
text.margin.top=0
text.margin.bottom=0
text.margin.left=4
text.margin.right=4
text.bold=false

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.margin=2
indicator.size=16
indicator.element=mdi
text.normal.color={{ textFaint }}
text.focus.color={{ text }}
text.bold=false

[ComboBox]
inherits=PanelButtonCommand
frame.element=combo
interior.element=combo

[GroupBox]
inherits=GenericFrame
frame=false
text.shadow=0
text.margin=0
text.normal.color={{ text }}
text.focus.color={{ text }}
text.bold=true

[TabBarFrame]
inherits=GenericFrame
frame=false
frame.element=tabBarFrame
interior=false
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[ToolTip]
inherits=GenericFrame
frame.top={{ size.popup }}
frame.bottom={{ size.popup }}
frame.left={{ size.popup }}
frame.right={{ size.popup }}
interior=true
text.shadow=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=3
text.margin.right=3
interior.element=tooltip
frame.element=tooltip
frame.expansion=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=true
interior.element=window
frame=false
