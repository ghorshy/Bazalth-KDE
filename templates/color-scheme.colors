# Generated by build.py from palette.toml; edit templates/color-scheme.colors instead.
[ColorEffects:Disabled]
Color={{ rgb(base) }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=false
Enable=false

[Colors:Button]
BackgroundNormal={{ rgb(mix(surface, base, opacity.muted)) }}
BackgroundAlternate={{ rgb(surface) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Complementary]
BackgroundNormal={{ rgb(base) }}
BackgroundAlternate={{ rgb(mix(surface, base, opacity.hover)) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Header]
BackgroundNormal={{ rgb(base) }}
BackgroundAlternate={{ rgb(mix(surface, base, opacity.hover)) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Header][Inactive]
BackgroundNormal={{ rgb(base) }}
BackgroundAlternate={{ rgb(mix(surface, base, opacity.hover)) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Selection]
BackgroundNormal={{ rgb(overlay) }}
BackgroundAlternate={{ rgb(overlay) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Selection][Inactive]
BackgroundNormal={{ rgb(overlay) }}
BackgroundAlternate={{ rgb(overlay) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Tooltip]
BackgroundNormal={{ rgb(base) }}
BackgroundAlternate={{ rgb(mix(surface, base, opacity.hover)) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:View]
BackgroundNormal={{ rgb(view) }}
BackgroundAlternate={{ rgb(mix(surface, view, opacity.hover / 2)) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[Colors:Window]
BackgroundNormal={{ rgb(base) }}
BackgroundAlternate={{ rgb(mix(surface, base, opacity.hover)) }}
DecorationFocus={{ rgb(borderActive) }}
DecorationHover={{ rgb(textDim) }}
ForegroundActive={{ rgb(text) }}
ForegroundInactive={{ rgb(textFaint) }}
ForegroundLink={{ rgb(link) }}
ForegroundNegative={{ rgb(urgent) }}
ForegroundNeutral={{ rgb(warning) }}
ForegroundNormal={{ rgb(text) }}
ForegroundPositive={{ rgb(positive) }}
ForegroundVisited={{ rgb(mix(link, text, opacity.muted)) }}

[General]
ColorScheme={{ name }}
Name={{ name }}
shadeSortColumn=false

[KDE]
contrast=4

[WM]
activeBackground={{ rgb(base) }}
activeBlend={{ rgb(base) }}
activeForeground={{ rgb(text) }}
inactiveBackground={{ rgb(base) }}
inactiveBlend={{ rgb(base) }}
inactiveForeground={{ rgb(textFaint) }}
